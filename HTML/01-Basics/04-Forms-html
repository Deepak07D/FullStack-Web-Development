<!DOCTYPE html>

<html>

<head>
    <title>Student Registration</title>
</head>

<body>

    <h1>Student Registration Form</h1>

    <hr>

    <form>

        <!-- Name -->

        <label for="name">Full Name:</label>

        <input
            type="text"
            id="name"
            name="name"
            placeholder="Enter your name"
            required
        >

        <br><br>


        <!-- Email -->

        <label for="email">Email:</label>

        <input
            type="email"
            id="email"
            name="email"
            placeholder="Enter your email"
            required
        >

        <br><br>


        <!-- Password -->

        <label for="password">Password:</label>

        <input
            type="password"
            id="password"
            name="password"
            placeholder="Enter password"
            required
        >

        <br><br>


        <!-- Age -->

        <label for="age">Age:</label>

        <input
            type="number"
            id="age"
            name="age"
            min="1"
            max="100"
        >

        <br><br>


        <!-- Gender -->

        <p>Gender:</p>

        <input
            type="radio"
            id="male"
            name="gender"
            value="male"
        >

        <label for="male">Male</label>


        <input
            type="radio"
            id="female"
            name="gender"
            value="female"
        >

        <label for="female">Female</label>

        <br><br>


        <!-- Skills -->

        <p>Skills:</p>

        <input
            type="checkbox"
            id="python"
            name="skills"
            value="python"
        >

        <label for="python">Python</label>


        <input
            type="checkbox"
            id="cpp"
            name="skills"
            value="cpp"
        >

        <label for="cpp">C++</label>


        <input
            type="checkbox"
            id="html"
            name="skills"
            value="html"
        >

        <label for="html">HTML</label>

        <br><br>


        <!-- Course -->

        <label for="course">Course:</label>

        <select id="course" name="course">

            <option value="cse">
                Computer Science
            </option>

            <option value="ece">
                Electronics
            </option>

            <option value="me">
                Mechanical
            </option>

        </select>

        <br><br>


        <!-- Message -->

        <label for="message">About Yourself:</label>

        <br>

        <textarea
            id="message"
            name="message"
            rows="5"
            cols="40"
            placeholder="Write something about yourself"
        ></textarea>

        <br><br>


        <!-- Submit -->

        <button type="submit">
            Register
        </button>

    </form>

</body>

</html>
